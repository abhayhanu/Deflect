# Copy this file to .env and fill in what you need.
# Leave a value empty to use the default from the compose file or the Python code.

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=
# The agent's own role, created by the migrations. It may only add rows to the audit log.
DEFLECT_APP_DB_PASSWORD=
DEFLECT_APP_DATABASE_URL=

# Qdrant
QDRANT_URL=
QDRANT_HTTP_PORT=
QDRANT_GRPC_PORT=
QDRANT_COLLECTION=
DEFLECT_EMBED_MODEL=

# Seed data
DEFLECT_SEED_ANCHOR=

# Model providers, used from Phase 1. Provider is ollama, openai or anthropic.
DEFLECT_PROVIDER=
DEFLECT_MODEL=
DEFLECT_JUDGE_PROVIDER=
DEFLECT_JUDGE_MODEL=
OLLAMA_BASE_URL=
DEFLECT_OLLAMA_NUM_CTX=
DEFLECT_USD_TO_INR=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MCP server, used from Phase 2. Transport is stdio or http.
MCP_TRANSPORT=
MCP_HTTP_PORT=
MCP_HTTP_URL=
MCP_HTTP_TOKEN=
MCP_HTTP_READONLY_TOKEN=

# API, used from Phase 3. Set a token before exposing it beyond your own machine.
DEFLECT_API_TOKEN=
# seed_anchor pins the clock to the seed time, which the demo data expects
DEFLECT_CLOCK=

# Tracing, used from Phase 4
DEFLECT_TRACE_BACKEND=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
