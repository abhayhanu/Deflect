# Copy this file to .env and fill in what you need.
# Leave a value empty to use the default from the compose file or the Python code.

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=
# The agent's own role, created by the migrations. It may only add rows to the audit log.
DEFLECT_APP_DB_PASSWORD=
DEFLECT_APP_DATABASE_URL=

# Qdrant
QDRANT_URL=
QDRANT_HTTP_PORT=
QDRANT_GRPC_PORT=
QDRANT_COLLECTION=
# Only for a hosted Qdrant. A local one needs no key.
QDRANT_API_KEY=
DEFLECT_EMBED_MODEL=

# Seed data. Set a fixed anchor for recorded eval runs, so two versions see exactly the same
# tickets and dates. It is an ISO timestamp in UTC.
DEFLECT_SEED_ANCHOR=

# Model providers, used from Phase 1. Provider is ollama, gemini, openai or anthropic.
DEFLECT_PROVIDER=
DEFLECT_MODEL=
DEFLECT_JUDGE_PROVIDER=
DEFLECT_JUDGE_MODEL=
OLLAMA_BASE_URL=
DEFLECT_OLLAMA_NUM_CTX=
DEFLECT_USD_TO_INR=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# A ceiling on requests per minute to a hosted model. Set it on a free tier that allows few.
DEFLECT_MAX_RPM=

# The model that checks a drafted reply against its sources. Empty means the agent's own model.
# jev asks about one sentence at a time and needs TYPESAFE_API_KEY. A chat provider such as
# gemini also works here, with DEFLECT_CHECKER_MODEL to pick the model.
DEFLECT_CHECKER_PROVIDER=
DEFLECT_CHECKER_MODEL=
# The model that classifies the ticket. Empty means the agent's own model. It works the same
# way as the checker's setting and is independent of it. jev answers three closed questions
# per ticket, and the order id is then read from the message by pattern.
DEFLECT_CLASSIFIER_PROVIDER=
DEFLECT_CLASSIFIER_MODEL=
TYPESAFE_API_KEY=

# MCP server, used from Phase 2. Transport is stdio or http.
MCP_TRANSPORT=
MCP_HTTP_PORT=
MCP_HTTP_URL=
MCP_HTTP_TOKEN=
MCP_HTTP_READONLY_TOKEN=

# API, used from Phase 3. Set a token before exposing it beyond your own machine.
DEFLECT_API_TOKEN=
# seed_anchor pins the clock to the seed time, which the demo data expects
DEFLECT_CLOCK=

# Console and demo, used from Phase 5.
# 1 turns the API into the public demo: ten tickets loaded at startup, a stricter rate limit
# and a daily model budget. It also pins the clock to the seed time.
DEFLECT_DEMO=
# Runs one caller may start in a minute. 60 by default, 6 in the demo.
DEFLECT_RATE_PER_MINUTE=
# Model spend in rupees after which no new run starts that day. No cap by default, 25 in the demo.
DEFLECT_DAILY_BUDGET_INR=
# Set to 1 only behind a hosting platform's proxy, so the rate limit sees the visitor and not the proxy.
DEFLECT_TRUST_PROXY=
# The address of one trace in your trace backend, with {trace_id} where the id goes.
# The run view then links every ticket to its trace.
DEFLECT_TRACE_URL=

# Tracing, used from Phase 4. Backend is none, langfuse, langsmith, both or console.
DEFLECT_TRACE_BACKEND=
# The self hosted Langfuse from the tracing profile creates a project with these two keys on
# its first start, so they work with no clicking. Change them before exposing it to anyone.
LANGFUSE_PUBLIC_KEY=pk-lf-deflect-local
LANGFUSE_SECRET_KEY=sk-lf-deflect-local
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Only for an account outside the US region. Running the agent.tracing module tells you the value.
LANGSMITH_ENDPOINT=
# Only for a key that belongs to more than one workspace.
LANGSMITH_WORKSPACE_ID=
